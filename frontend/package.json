{
  "name": "solo-shop-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "素のHTML/CSS/JavaScript（ES Modules）で実装されたフロントエンド。配信にビルドは不要（CSSは生成済みをコミット）",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind-src.css -o assets/css/style.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
