# 毎日のバックアップを実行する（soloshop-backup.timer から呼ばれる）
#
# 置き場所: /etc/systemd/system/soloshop-backup.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now soloshop-backup.timer
#   sudo systemctl start soloshop-backup      # すぐ1回試す
#   sudo journalctl -u soloshop-backup        # 結果を見る

[Unit]
Description=Solo Shop のバックアップ
After=postgresql.service

[Service]
Type=oneshot
User=soloshop
Group=soloshop
WorkingDirectory=/var/www/soloshop
ExecStart=/var/www/soloshop/deploy/backup.sh
Environment=BACKUP_DIR=/var/backups/soloshop
Environment=KEEP_DAYS=14

# 書き込みを許すのは保存先だけ
ProtectSystem=strict
ReadWritePaths=/var/backups/soloshop
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
