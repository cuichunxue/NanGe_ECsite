# サーバー設定
PORT=4000
NODE_ENV=development

# リバースプロキシ（nginx / Cloudflare など）の背後で動かす場合に設定する。
# 未設定だと訪問者のIPが全てプロキシのIPとして扱われ、レート制限が訪問者ごとではなく
# サイト全体にかかるため、アクセスが集中した際に全員が締め出される。
# プロキシ1段なら 1、Cloudflare+nginx のように2段なら 2 を指定する。
# 直接インターネットに公開している場合は、詐称による制限回避を防ぐため未設定のままにする。
# TRUST_PROXY=1

# データベース
DATABASE_URL="postgresql://soloshop:soloshop_password@localhost:5432/soloshop?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# 初期店主(管理者)アカウント（seed用）
ADMIN_EMAIL="owner@soloshop.example.com"
ADMIN_PASSWORD="Owner@12345"

# 請求書・領収書に記載する事業者情報
# INVOICE_ISSUER_NAME="【氏名または屋号】"
#
# 適格請求書発行事業者として登録した場合のみ、登録番号(T+13桁)を設定する。
# 設定すると書類が「適格請求書」として発行され、税率ごとの消費税額が記載される。
# 免税事業者は適格請求書を発行できないため、未設定のままにすること
# （未設定の場合は「領収書」として発行し、適格請求書ではない旨を明記する）。
# INVOICE_REGISTRATION_NUMBER="T1234567890123"

# 商品画像のアップロード
# UPLOAD_DIR="uploads"                          # 保存先（既定はbackend/uploads。バックアップ対象に含めること）
# PUBLIC_API_URL="https://api.example.com"      # このAPIサーバーの公開URL。画像URLの組み立てに使う

# 支払われないまま放置された注文の在庫を、何分後に売り場へ戻すか（既定60分、最小10分）。
# 注文と同時に在庫を確保しているため、戻さないと決済ページで離脱されただけで
# その商品が売れなくなる。決済ページの有効期限は自動的にこの半分になる。
# PAYMENT_HOLD_MINUTES=60

# 決済（KOMOJU）
# 設定するとクレジットカード・PayPayでの支払いが有効になる。
# 未設定の間は、購入者が支払いに進もうとするとエラーになる（注文は「支払い待ち」で残る）。
# 代金引換は KOMOJU を経由しないため、未設定でも利用できる。
# KOMOJU_SECRET_KEY="sk_live_******"       # KOMOJU管理画面の「シークレットキー」
# KOMOJU_WEBHOOK_SECRET="******"           # Webhook設定画面で発行される署名用の秘密鍵
# KOMOJU_API_BASE="https://komoju.com/api/v1"   # 通常は変更不要（検証用に差し替える場合のみ）
#
# KOMOJUの管理画面で、Webhookの送信先に次のURLを登録すること:
#   https://<バックエンドの公開URL>/api/webhooks/komoju
# 送信するイベント: payment.captured / payment.refunded
#   （任意で payment.failed / payment.expired / payment.cancelled）

# メール通知
# SMTP_HOST と MAIL_FROM の両方を設定すると送信が有効になる。
# 未設定の間は送信せず、内容をサーバーのログに出力する（開発中の動作確認用）。
# 送信されるメール:
#   - 注文確定時: 購入者へ注文内容の控え
#   - 支払い完了時: 店主へ「新しいご注文がありました」
#   - 発送時: 購入者へ発送のお知らせ
#   - パスワード再設定の申請時: 再設定リンク
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false          # ポート465(SSL)を使う場合のみ true
# SMTP_USER="******"
# SMTP_PASS="******"
# MAIL_FROM="Solo Shop <shop@example.com>"
# OWNER_EMAIL="owner@example.com"   # 注文通知の宛先。未設定なら店主アカウントのアドレス宛
# SITE_URL="https://shop.example.com"  # メール本文に載せるリンクの基点
