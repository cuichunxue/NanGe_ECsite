# サーバー設定
PORT=4000
NODE_ENV=development

# リバースプロキシ（nginx / Cloudflare など）の背後で動かす場合に設定する。
# 未設定だと訪問者のIPが全てプロキシのIPとして扱われ、レート制限が訪問者ごとではなく
# サイト全体にかかるため、アクセスが集中した際に全員が締め出される。
# プロキシ1段なら 1、Cloudflare+nginx のように2段なら 2 を指定する。
# 直接インターネットに公開している場合は、詐称による制限回避を防ぐため未設定のままにする。
# TRUST_PROXY=1

# データベース
DATABASE_URL="postgresql://soloshop:soloshop_password@localhost:5432/soloshop?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# 初期店主(管理者)アカウント（seed用）
ADMIN_EMAIL="owner@soloshop.example.com"
ADMIN_PASSWORD="Owner@12345"

# メール通知
# SMTP_HOST と MAIL_FROM の両方を設定すると送信が有効になる。
# 未設定の間は送信せず、内容をサーバーのログに出力する（開発中の動作確認用）。
# 送信されるメール:
#   - 注文確定時: 購入者へ注文内容の控え
#   - 支払い完了時: 店主へ「新しいご注文がありました」
#   - 発送時: 購入者へ発送のお知らせ
#   - パスワード再設定の申請時: 再設定リンク
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false          # ポート465(SSL)を使う場合のみ true
# SMTP_USER="******"
# SMTP_PASS="******"
# MAIL_FROM="Solo Shop <shop@example.com>"
# OWNER_EMAIL="owner@example.com"   # 注文通知の宛先。未設定なら店主アカウントのアドレス宛
# SITE_URL="https://shop.example.com"  # メール本文に載せるリンクの基点
