{
  "name": "soloshop",
  "version": "1.0.0",
  "private": true,
  "description": "Solo Shop — 個人向け小規模ECサイト（backend/ と frontend/ をnpm workspacesでまとめて操作する）",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend",
    "build:css": "npm run build:css -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "lint": "eslint .",
    "seed": "npm run seed -w backend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w backend",
    "mail:check": "npm run mail:check -w backend",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
